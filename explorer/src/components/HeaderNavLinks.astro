---
interface CustomPageLink {
  href: string;
  label: string;
}

interface Props {
  roleId?: string;
  roleName?: string;
  customPageLinks?: CustomPageLink[];
  /** Wider tap targets and block layout for the mobile drawer */
  mobile?: boolean;
}

const { roleId, roleName, customPageLinks = [], mobile } = Astro.props;
const linkClass = mobile ? "nav-link nav-link--stacked" : "nav-link";
---

<a class={linkClass} href="/">Home</a>
<a class={linkClass} href="/secretariat">Secretariat</a>
<a class={linkClass} href="/operational-business">Operational Business</a>
<a class={linkClass} href="/entities">Entities</a>
<a class={linkClass} href="/agents">Agents</a>
{customPageLinks.map((link) => <a class={linkClass} href={link.href}>{link.label}</a>)}
<a class={linkClass} href="/architecture">Architecture</a>
<a class={linkClass} href="/license">License</a>
{roleId && <a class={linkClass} href={`/agents/${roleId}`}>{roleName ?? roleId}</a>}
