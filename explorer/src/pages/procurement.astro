---
import path from "node:path";
import { promises as fs } from "node:fs";

import BaseLayout from "../layouts/BaseLayout.astro";
import { getWorkspaceRoot } from "../lib/workspace.js";

interface ScanRow {
  domain: string;
  sampleEmail: string;
  sampleName: string;
  messageCount: number;
  procurementMessageCount: number;
  amountMentions: string[];
  latestMessageAt: string | null;
  subjects: string[];
}

interface ScanFile {
  fetched?: number;
  since?: string;
  included?: number;
  summary?: ScanRow[];
}

interface ProgressStage {
  id: string;
  label: string;
  status: "done" | "in_progress" | "pending";
}

interface ProgressFile {
  status?: string;
  summary?: string;
  scope?: {
    email_since?: string;
    slack_enabled?: boolean;
    spend_rule?: string;
  };
  stages?: ProgressStage[];
}

interface SupplierEntry {
  name: string;
  confidence: string;
  source_domains: string[];
  website?: string;
  email_addresses?: string[];
  main_contacts?: string[];
  location?: string;
  recurrent_products?: string[];
  total_spend?: string;
  slack_evidence?: string;
  notes?: string;
}

interface SupplierSection {
  id: string;
  label: string;
  suppliers: SupplierEntry[];
}

interface SupplierDirectoryFile {
  generated_at?: string;
  email_since?: string;
  slack_checked?: boolean;
  method_note?: string;
  sections?: SupplierSection[];
}

const root = getWorkspaceRoot();
const workItemPath = path.join(root, "entities", "work-items", "wi-build-supplier-directory-from-email-history");
const artifactsPath = path.join(workItemPath, "artifacts");
const scanPath = path.join(artifactsPath, "domain-scan.json");
const progressPath = path.join(artifactsPath, "progress.json");
const supplierDirectoryPath = path.join(artifactsPath, "supplier-directory.json");

async function readJson<T>(filePath: string): Promise<T | undefined> {
  try {
    return JSON.parse(await fs.readFile(filePath, "utf8")) as T;
  } catch (error) {
    const code = error && typeof error === "object" && "code" in error ? (error as NodeJS.ErrnoException).code : undefined;
    if (code === "ENOENT") {
      return undefined;
    }
    throw error;
  }
}

function statusLabel(status: ProgressStage["status"]): string {
  if (status === "done") return "Done";
  if (status === "in_progress") return "In progress";
  return "Pending";
}

function statusWeight(status: ProgressStage["status"]): number {
  if (status === "done") return 1;
  if (status === "in_progress") return 0.5;
  return 0;
}

function formatDateTime(value?: string | null): string {
  if (!value) return "Unknown";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return new Intl.DateTimeFormat("en-GB", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "Europe/Brussels",
  }).format(date);
}

function formatPercent(value: number): string {
  return `${Math.round(value)}%`;
}

const [scan, progress, supplierDirectory, scanStat] = await Promise.all([
  readJson<ScanFile>(scanPath),
  readJson<ProgressFile>(progressPath),
  readJson<SupplierDirectoryFile>(supplierDirectoryPath),
  fs.stat(scanPath).catch(() => undefined),
]);

const stages = progress?.stages ?? [];
const completion = stages.length > 0
  ? (stages.reduce((sum, stage) => sum + statusWeight(stage.status), 0) / stages.length) * 100
  : 0;

const summary = scan?.summary ?? [];
const candidateCount = summary.length;
const amountCoverageCount = summary.filter((row) => (row.amountMentions?.length ?? 0) > 0).length;
const spendCoverage = candidateCount > 0 ? (amountCoverageCount / candidateCount) * 100 : 0;
const lastUpdatedAt = scanStat?.mtime?.toISOString();

const curatedSections = supplierDirectory?.sections ?? [];
const curatedSupplierCount = curatedSections.reduce((sum, section) => sum + section.suppliers.length, 0);
---
<BaseLayout title="Procurement">
  <div class="breadcrumb">
    <a href="/">Raidyn Virtual Assistent - Explorer</a> → Procurement
  </div>
  <div class="page-intro">
    <h1>Procurement</h1>
    <p class="meta">Supplier directory built from emails from June 2025 onward, with light Slack cross-checking used only as secondary context.</p>
  </div>

  <section class="file-section card">
    <h2>Progress</h2>
    <div class="progress-grid">
      <div class="metric-card metric-card--primary">
        <span class="label">Completion</span>
        <div class="value">{formatPercent(completion)}</div>
        <div class="subvalue">Current procurement-directory workflow progress</div>
      </div>
      <div class="metric-card">
        <span class="label">Scan status</span>
        <div class="value">{progress?.status === "in_progress" ? "In progress" : progress?.status ?? "Not started"}</div>
        <div class="subvalue">Mailbox-first supplier mapping</div>
      </div>
      <div class="metric-card">
        <span class="label">Curated suppliers</span>
        <div class="value">{curatedSupplierCount}</div>
        <div class="subvalue">Cleaned supplier entries with requested fields</div>
      </div>
      <div class="metric-card">
        <span class="label">Raw candidates found</span>
        <div class="value">{candidateCount}</div>
        <div class="subvalue">Automatically detected candidate domains</div>
      </div>
      <div class="metric-card">
        <span class="label">Spend-evidence coverage</span>
        <div class="value">{formatPercent(spendCoverage)}</div>
        <div class="subvalue">Candidates with at least one visible amount mention</div>
      </div>
      <div class="metric-card">
        <span class="label">Email window</span>
        <div class="value value--small">{scan?.since ? scan.since.slice(0, 10) : progress?.scope?.email_since?.slice(0, 10) ?? supplierDirectory?.email_since?.slice(0, 10) ?? "Unknown"}</div>
        <div class="subvalue">Messages on or after this date</div>
      </div>
      <div class="metric-card">
        <span class="label">Slack checked</span>
        <div class="value">{supplierDirectory?.slack_checked ? "Yes" : "No"}</div>
        <div class="subvalue">Used only as secondary supporting context</div>
      </div>
      <div class="metric-card">
        <span class="label">Last update</span>
        <div class="value value--small">{formatDateTime(lastUpdatedAt)}</div>
        <div class="subvalue">Latest saved scan artifact</div>
      </div>
    </div>
    {progress?.summary && <p class="meta progress-note">{progress.summary}</p>}
    {supplierDirectory?.method_note && <p class="meta progress-note">{supplierDirectory.method_note}</p>}
    {stages.length > 0 && (
      <details class="workflow-stages-toggle">
        <summary class="workflow-stages-summary">
          <span class="workflow-stages-title">Workflow stages</span>
          <span class="meta">Open stage-by-stage progress</span>
        </summary>
        <div class="stage-list">
          {stages.map((stage) => (
            <div class={`stage-row stage-row--${stage.status}`}>
              <span class="stage-label">{stage.label}</span>
              <span class={`stage-status stage-status--${stage.status}`}>{statusLabel(stage.status)}</span>
            </div>
          ))}
        </div>
      </details>
    )}
  </section>

  {curatedSections.map((section) => (
    <details class="file-section card procurement-section" open>
      <summary class="procurement-section-summary">
        <div>
          <span class="procurement-section-title">{section.label}</span>
          <div class="meta">{section.suppliers.length} supplier entries</div>
        </div>
      </summary>
      <div class="procurement-section-body">
        <div class="candidate-list">
          {section.suppliers.map((supplier) => (
            <details class="candidate-card" data-supplier-card>
              <summary class="candidate-summary">
                <div>
                  <strong>{supplier.name}</strong>
                  <div class="meta">{supplier.confidence}</div>
                </div>
                <div class="candidate-summary-metrics">
                  <span>{supplier.total_spend || "Spend unknown"}</span>
                  <button
                    type="button"
                    class="todo-delete-button"
                    data-supplier-delete
                    data-section-id={section.id}
                    data-supplier-name={supplier.name}
                    aria-label={`Remove ${supplier.name}`}
                  >
                    Done / delete
                  </button>
                </div>
              </summary>
              <div class="candidate-body">
                <div class="candidate-detail-grid">
                  <div>
                    <span class="label">Emails</span>
                    <div>{supplier.email_addresses?.length ? supplier.email_addresses.join(", ") : "Unknown"}</div>
                  </div>
                  <div>
                    <span class="label">Main contacts</span>
                    <div>{supplier.main_contacts?.length ? supplier.main_contacts.join(", ") : "Unknown"}</div>
                  </div>
                  <div>
                    <span class="label">Website</span>
                    <div>
                      {supplier.website ? <a href={supplier.website} target="_blank" rel="noreferrer">{supplier.website}</a> : "Unknown"}
                    </div>
                  </div>
                  <div>
                    <span class="label">Location</span>
                    <div>{supplier.location || "Unknown"}</div>
                  </div>
                  <div>
                    <span class="label">Recurrent products bought</span>
                    <div>{supplier.recurrent_products?.length ? supplier.recurrent_products.join(" · ") : "Unknown"}</div>
                  </div>
                  <div>
                    <span class="label">Total spend</span>
                    <div>{supplier.total_spend || "Unknown"}</div>
                  </div>
                  <div>
                    <span class="label">Slack check</span>
                    <div>{supplier.slack_evidence || "No supporting Slack evidence recorded."}</div>
                  </div>
                  <div>
                    <span class="label">Source domains</span>
                    <div>{supplier.source_domains?.length ? supplier.source_domains.join(", ") : "Unknown"}</div>
                  </div>
                </div>
                {supplier.notes && <p class="meta supplier-note">{supplier.notes}</p>}
              </div>
            </details>
          ))}
        </div>
      </div>
    </details>
  ))}

  <script is:inline>
    (() => {
      const deleteSupplier = async (button) => {
        if (!(button instanceof HTMLButtonElement)) {
          return;
        }
        const sectionId = button.getAttribute("data-section-id") || "";
        const name = button.getAttribute("data-supplier-name") || "";
        if (!sectionId || !name) {
          return;
        }
        if (!window.confirm(`Remove "${name}" from the supplier directory?`)) {
          return;
        }

        const card = button.closest("[data-supplier-card]");
        button.disabled = true;
        button.textContent = "Deleting…";
        try {
          const response = await fetch("/api/procurement-suppliers/delete", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ sectionId, name }),
          });
          if (!response.ok) {
            const payload = await response.json().catch(() => ({}));
            throw new Error(payload?.error || "Delete failed.");
          }
          if (card instanceof HTMLElement) {
            card.remove();
          }
        } catch (error) {
          window.alert(error instanceof Error ? error.message : "Delete failed.");
          button.disabled = false;
          button.textContent = "Done / delete";
        }
      };

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }
        const button = target.closest("[data-supplier-delete]");
        if (button) {
          event.preventDefault();
          event.stopPropagation();
          void deleteSupplier(button);
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  .progress-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .metric-card {
    padding: 0.9rem 1rem;
    border-radius: 0.75rem;
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
  }

  .metric-card--primary {
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
    box-shadow: 0 0 0 1px var(--color-accent-soft) inset;
  }

  .label {
    display: block;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
    margin-bottom: 0.35rem;
  }

  .value {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .value--small {
    font-size: 1rem;
  }

  .subvalue,
  .progress-note,
  .section-note,
  .supplier-note {
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .progress-note {
    margin-top: 1rem;
  }

  .workflow-stages-toggle {
    margin-top: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    background: var(--color-surface-subtle);
    overflow: hidden;
  }

  .workflow-stages-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    cursor: pointer;
  }

  .workflow-stages-summary::-webkit-details-marker {
    display: none;
  }

  .workflow-stages-title {
    font-weight: 700;
  }

  .stage-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
    padding: 0 1.1rem 1rem;
  }

  .stage-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 0.75rem;
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
  }

  .stage-status {
    white-space: nowrap;
    font-weight: 600;
  }

  .stage-status--done {
    color: #7dd3a7;
  }

  .stage-status--in_progress {
    color: var(--color-accent);
  }

  .stage-status--pending {
    color: var(--color-text-soft);
  }

  .procurement-section {
    overflow: hidden;
  }

  .procurement-section-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    cursor: pointer;
  }

  .procurement-section-summary::-webkit-details-marker {
    display: none;
  }

  .procurement-section-title {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .procurement-section-body {
    padding: 0 1.1rem 1rem;
  }

  .candidate-list {
    display: grid;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .candidate-card {
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    background: var(--color-surface-muted);
    overflow: hidden;
  }

  .candidate-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem;
    cursor: pointer;
  }

  .candidate-summary::-webkit-details-marker {
    display: none;
  }

  .candidate-summary-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.9rem;
    opacity: 0.85;
    justify-content: flex-end;
    text-align: right;
  }

  .candidate-body {
    padding: 0 1.1rem 1rem;
  }

  .candidate-detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .supplier-note {
    margin-top: 1rem;
  }
</style>
