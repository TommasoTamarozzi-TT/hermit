---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatCurrency, formatInteger, getUsageForPeriod } from "../lib/openai-usage.js";
import { getWorkspaceRoot } from "../lib/workspace.js";

const root = getWorkspaceRoot();
const timeZone = "Europe/Brussels";

const now = new Date();
const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());
const weekStart = new Date(todayStart);
weekStart.setDate(weekStart.getDate() - 7);
const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);

const todayTotals = await getUsageForPeriod(root, todayStart, now);
const weekTotals = await getUsageForPeriod(root, weekStart, now);
const monthTotals = await getUsageForPeriod(root, monthStart, now);
---
<BaseLayout title="Secretariat">
  <div class="breadcrumb">
    <a href="/">Raidyn Virtual Assistent - Explorer</a> → Secretariat
  </div>
  <div class="page-intro">
    <h1>Secretariat</h1>
    <p class="meta">Operational views for summaries, travel planning, and follow-through.</p>
  </div>

  <details class="file-section card" open>
    <summary>AI Cloud Billing</summary>
    <div class="usage-grid">
      <div class="usage-item">
        <span class="label">Today</span>
        <div class="value">{formatCurrency(todayTotals.cost)}</div>
        <div class="subvalue">{formatInteger(todayTotals.tokens)} tokens</div>
      </div>
      <div class="usage-item">
        <span class="label">This Week</span>
        <div class="value">{formatCurrency(weekTotals.cost)}</div>
        <div class="subvalue">{formatInteger(weekTotals.tokens)} tokens</div>
      </div>
      <div class="usage-item">
        <span class="label">This Month</span>
        <div class="value">{formatCurrency(monthTotals.cost)}</div>
        <div class="subvalue">{formatInteger(monthTotals.tokens)} tokens</div>
      </div>
      <div class="usage-item">
        <span class="label">Remaining credits</span>
        <div class="value">Unavailable</div>
        <div class="subvalue">Not stored in local workspace logs</div>
      </div>
    </div>
    <p class="meta" style="margin-top: 1rem;">
      Data based on {formatInteger(todayTotals.entries)} usage entries from recorded sessions in {timeZone}. Remaining credit balance needs a separate billing source and is not available from the local session files alone.
    </p>
  </details>

  <div class="entity-type-list">
    <a href="/tables">
      <strong class="link-title">Tables</strong>
      <span class="meta"> — unread email, calendar action days, Slack summary, and the latest digest snapshot</span>
    </a>
    <a href="/travel-organizer">
      <strong class="link-title">Travel Organizer</strong>
      <span class="meta"> — foldable trip cards with booking links, recommendations, and booking status</span>
    </a>
  </div>
</BaseLayout>

<style>
  .usage-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .usage-item {
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .usage-item .label {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
    margin-bottom: 0.25rem;
  }
  .usage-item .value {
    font-size: 1.25rem;
    font-weight: bold;
  }
  .usage-item .subvalue {
    font-size: 0.85rem;
    opacity: 0.8;
  }
  .link-title {
    display: block;
  }
</style>
