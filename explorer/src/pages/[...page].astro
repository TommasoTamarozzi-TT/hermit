---
import BaseLayout from "../layouts/BaseLayout.astro";
import { renderExplorerCustomPage } from "../lib/renderers.js";
import { getWorkspaceRoot, loadEntityDefs } from "../lib/workspace.js";

const pageParam = Astro.params.page;
const pageKey = Array.isArray(pageParam) ? pageParam.join("/") : pageParam ?? "";
if (!pageKey) {
  return Astro.redirect("/");
}

if (pageKey === "daily-digest" || pageKey === "slack-summary") {
  return Astro.redirect("/tables");
}

const root = getWorkspaceRoot();
const { explorer } = await loadEntityDefs(root);
const renderedPage = await renderExplorerCustomPage({ root, explorer, pageKey });
if (!renderedPage) {
  return new Response("Not found", { status: 404 });
}
---
<BaseLayout title={renderedPage.title ?? pageKey}>
  <div data-explorer-page={pageKey} set:html={renderedPage.html} />

  {pageKey === "market-analysis" && (
    <script is:inline>
      (() => {
        const closeFoldables = () => {
          document
            .querySelectorAll('[data-explorer-page="market-analysis"] details.foldable-card')
            .forEach((item) => {
              if (item instanceof HTMLDetailsElement) {
                item.open = false;
                item.removeAttribute("open");
              }
            });
        };

        closeFoldables();
        document.addEventListener("DOMContentLoaded", closeFoldables);
        document.addEventListener("astro:page-load", closeFoldables);
      })();
    </script>
  )}
</BaseLayout>
