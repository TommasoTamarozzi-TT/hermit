  },
  {
    label: "Analyze data Vincent",
    priority: "medium",
    category: "engineering",
  },
  {
    label: "Aga review web",
    priority: "low",
    category: "marketing-web",
  },
];

const priorityRank: Record<TodoPriority, number> = {
  high: 0,
  medium: 1,
  low: 2,
  "needs-triage": 3,
};

const normalizeTaskLabel = (label: string) => label.toLowerCase().replace(/\s+/g, " ").trim();
const toTaskId = (label: string) =>
  normalizeTaskLabel(label)
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

function buildTodoItems(tasks: TodoTaskInput[]): TodoItem[] {
  const uniqueTasks = Array.from(
    new Map(tasks.map((task) => [normalizeTaskLabel(task.label), task])).values(),
  );

  return uniqueTasks
    .map((task) => ({
      ...task,
      id: toTaskId(task.label),
    }))
    .sort((a, b) => {
      const priorityDiff = priorityRank[a.priority] - priorityRank[b.priority];
      if (priorityDiff !== 0) {
        return priorityDiff;
      }
      return a.label.localeCompare(b.label);
    });
}

const userRequestedItems = buildTodoItems(
  todoSections.userRequested.length > 0 ? todoSections.userRequested : fallbackTasks,
);
const secretaryManagedItems = buildTodoItems(todoSections.secretaryManaged);

const userHighPriorityCount = userRequestedItems.filter((item) => item.priority === "high").length;
const userMediumPriorityCount = userRequestedItems.filter((item) => item.priority === "medium").length;
---
<BaseLayout title="Raidyn Virtual Assistent - Explorer">
  {prioritiesHtml && (
    <details class="card foldable-card">
      <summary class="foldable-summary">
        <span class="foldable-title">Raidyn cross-role priorities</span>
        <span class="foldable-meta">5 active priorities</span>
      </summary>
      <div class="foldable-body">
        <p class="meta">Canonical company-level priority stack shared across the active Raidyn roles.</p>
        <div class="markdown-body" set:html={prioritiesHtml} />
        <p class="meta"><a href={companyPageHref}>Open the Raidyn company record</a></p>
      </div>
    </details>
  )}

  <section class="card foldable-card home-todo-card">
    <details data-home-todo open>
      <summary class="foldable-summary">
        <div>
          <div class="foldable-title">Secretary to-do lists</div>
          <p class="foldable-meta">User-requested items stay separate from secretary-managed follow-through.</p>
        </div>
        <div class="todo-summary-badges">
          <span class="priority-pill priority-pill--high">{userHighPriorityCount} user high</span>
          <span class="priority-pill priority-pill--medium">{userMediumPriorityCount} user medium</span>
          <span class="priority-pill priority-pill--neutral">{userRequestedItems.length} user total</span>
          <span class="priority-pill priority-pill--neutral">{secretaryManagedItems.length} secretary total</span>
        </div>
      </summary>

      <div class="foldable-body todo-body">
        <div class="todo-category-grid">
          <details class="todo-category-card foldable-card" open>
            <summary class="foldable-summary todo-category-summary">
              <div>
                <h3>User-requested to-do list</h3>
                <p class="meta">These are the items Tommaso explicitly asked to create.</p>
              </div>
              <span class="todo-category-count">{userRequestedItems.length} item{userRequestedItems.length === 1 ? "" : "s"}</span>
            </summary>
            <div class="foldable-body todo-category-body">
              <ul class="todo-item-list">
                {userRequestedItems.map((item) => (
                  <li class="todo-item" data-todo-id={item.id}>
                    <div class="todo-item__content">
                      <span class={`priority-pill priority-pill--${item.priority}`}>
                        {item.priority === "needs-triage" ? "needs priority" : `${item.priority} priority`}
                      </span>
                      <p class="todo-item__label">{item.label}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </details>

          <details class="todo-category-card foldable-card" open>
            <summary class="foldable-summary todo-category-summary">
              <div>
                <h3>Secretary-managed to-do list</h3>
                <p class="meta">These are the short follow-through items the Secretary is keeping alive without replacing the user list.</p>
              </div>
              <span class="todo-category-count">{secretaryManagedItems.length} item{secretaryManagedItems.length === 1 ? "" : "s"}</span>
            </summary>
            <div class="foldable-body todo-category-body">
              <ul class="todo-item-list">
                {secretaryManagedItems.map((item) => (
                  <li class="todo-item" data-todo-id={item.id}>
                    <div class="todo-item__content">
                      <span class={`priority-pill priority-pill--${item.priority}`}>
                        {item.priority === "needs-triage" ? "needs priority" : `${item.priority} priority`}
                      </span>
                      <p class="todo-item__label">{item.label}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        </div>
      </div>
    </details>
  </section>
</BaseLayout>
