---
import fs from "node:fs/promises";
import BaseLayout from "../layouts/BaseLayout.astro";
import { renderMarkdown } from "../lib/renderers.js";

type TodoPriority = "high" | "medium" | "low" | "needs-triage";

type TodoCategoryId =
  | "business-development"
  | "engineering"
  | "projects-strategy"
  | "marketing-web"
  | "personal";

interface TodoTaskInput {
  label: string;
  priority: TodoPriority;
  category: TodoCategoryId;
}

interface TodoItem extends TodoTaskInput {
  id: string;
}

interface TodoCategory {
  id: TodoCategoryId;
  title: string;
  description: string;
  items: TodoItem[];
}

const categoryMeta: Record<TodoCategoryId, { title: string; description: string }> = {
  "business-development": {
    title: "Business Development",
    description: "Customer follow-up, quotations, and external communication.",
  },
  engineering: {
    title: "Engineering",
    description: "Technical work, analysis, and implementation tasks.",
  },
  "projects-strategy": {
    title: "Projects & Strategy",
    description: "Planning, positioning, coordination, and internal operational work.",
  },
  "marketing-web": {
    title: "Marketing & Web",
    description: "Website, reviews, posts, and public-facing updates.",
  },
  personal: {
    title: "Personal",
    description: "Personal follow-up items.",
  },
};

const secretaryRecordPath = "/home/rva/repos/hermit/workspace/agents/secretary/agent/record.md";
const companyRecordPath = "/home/rva/repos/hermit/workspace/entities/companies/co-raidyn/record.md";
const companyPageHref = "/entities/company/co-raidyn";

function inferCategory(label: string): TodoCategoryId {
  const normalized = label.toLowerCase();

  if (/(raise-of-capital|raise of capital|capital increase)/.test(normalized)) {
    return "projects-strategy";
  }

  if (/(erika)/.test(normalized)) {
    return "personal";
  }

  if (/(post|carosello|website|review)/.test(normalized)) {
    return "marketing-web";
  }

  if (/(car|motorbike|printer|filippo)/.test(normalized)) {
    return "personal";
  }

  if (/(email|answer|call|follow up|jordi|bart|elisabeth|arcelor|bekaert|saipem|deme|dnv|liebherr)/.test(normalized)) {
    return "business-development";
  }

  return "projects-strategy";
}

function cleanTaskLabel(label: string): string {
  return label.trim().replace(/[.]$/, "");
}


function extractMarkdownSection(markdown: string, heading: string): string {
  const escapedHeading = heading.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const match = markdown.match(new RegExp(`## ${escapedHeading}\\n([\\s\\S]*?)(?:\\n## |$)`));
  return match?.[1]?.trim() ?? "";
}

async function loadRaidynCrossRolePrioritiesHtml(): Promise<string> {
  const raw = await fs.readFile(companyRecordPath, "utf8").catch(() => "");
  if (!raw) {
    return "";
  }

  const sectionMarkdown = extractMarkdownSection(raw, "Raidyn Cross-Role Priorities");
  if (!sectionMarkdown) {
    return "";
  }

  return renderMarkdown(sectionMarkdown);
}

function extractSubheadingSection(markdown: string, heading: string): string {
  const escapedHeading = heading.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const match = markdown.match(new RegExp(`### ${escapedHeading}\\n([\\s\\S]*?)(?:\\n### |$)`));
  return match?.[1]?.trim() ?? "";
}

function parseTodoLines(block: string, defaultPriority: TodoPriority = "medium"): TodoTaskInput[] {
  const tasks: TodoTaskInput[] = [];
  let currentPriority: TodoPriority = defaultPriority;

  for (const line of block.split("\n")) {
    const trimmed = line.trim();
    if (!trimmed) {
      continue;
    }

    if (/^High priority$/i.test(trimmed)) {
      currentPriority = "high";
      continue;
    }
    if (/^Medium priority$/i.test(trimmed)) {
      currentPriority = "medium";
      continue;
    }
    if (/^Low priority$/i.test(trimmed)) {
      currentPriority = "low";
      continue;
    }
    if (/^Priority not yet set$/i.test(trimmed)) {
      currentPriority = "needs-triage";
      continue;
    }
    if (!trimmed.startsWith("- ")) {
      continue;
    }

    const content = trimmed.slice(2).trim();
    const explicitHigh = content.match(/^High priority:\s*(.+)$/i);
    const explicitMedium = content.match(/^Medium priority:\s*(.+)$/i);
    const explicitLow = content.match(/^Low priority:\s*(.+)$/i);
    const explicitTriage = content.match(/^Priority not yet set:\s*(.+)$/i);

    let priority = currentPriority;
    let label = cleanTaskLabel(content);

    if (explicitHigh) {
      priority = "high";
      label = cleanTaskLabel(explicitHigh[1]);
    } else if (explicitMedium) {
      priority = "medium";
      label = cleanTaskLabel(explicitMedium[1]);
    } else if (explicitLow) {
      priority = "low";
      label = cleanTaskLabel(explicitLow[1]);
    } else if (explicitTriage) {
      priority = "needs-triage";
      label = cleanTaskLabel(explicitTriage[1]);
    }

    if (!label) {
      continue;
    }

    tasks.push({
      label,
      priority,
      category: inferCategory(label),
    });
  }

  return tasks;
}

async function loadSecretaryTodoSections(): Promise<{ userRequested: TodoTaskInput[]; secretaryManaged: TodoTaskInput[] }> {
  const raw = await fs.readFile(secretaryRecordPath, "utf8").catch(() => "");
  if (!raw) {
    return { userRequested: [], secretaryManaged: [] };
  }

  const nextActionsMatch = raw.match(/## Next Actions\s+([\s\S]*?)\n## /);
  const nextActionsBlock = nextActionsMatch?.[1] ?? "";
  const userRequestedBlock = extractSubheadingSection(nextActionsBlock, "User-requested todo list");
  const secretaryManagedBlock = extractSubheadingSection(nextActionsBlock, "Secretary-managed todo list");

  return {
    userRequested: parseTodoLines(userRequestedBlock, "medium"),
    secretaryManaged: parseTodoLines(secretaryManagedBlock, "medium"),
  };
}

const prioritiesHtml = await loadRaidynCrossRolePrioritiesHtml();
const todoSections = await loadSecretaryTodoSections();

const fallbackTasks: TodoTaskInput[] = [
  {
    label: "Allow to debug production code",
    priority: "high",
    category: "engineering",
  },
  {
    label: "Write project about Sarens",
    priority: "high",
    category: "projects-strategy",
  },
  {
    label: "Send email to Arcelor",
    priority: "high",
    category: "business-development",
  },
  {
    label: "Implement position estimation",
    priority: "high",
    category: "engineering",
  },
  {
    label: "Make Hermit workspace repo",
    priority: "high",
    category: "projects-strategy",
  },
  {
    label: "Carlo bank transfer",
    priority: "high",
    category: "personal",
  },
  {
    label: "Posts Teufelberger",
    priority: "high",
    category: "marketing-web",
  },
  {
    label: "Post Zermatt",
    priority: "high",
    category: "marketing-web",
  },
  {
    label: "Launch website",
    priority: "high",
    category: "marketing-web",
  },
  {
    label: "Check Deme and send quotation",
    priority: "high",
    category: "business-development",
  },
  {
    label: "Send item to Arcelor",
    priority: "high",
    category: "business-development",
  },
  {
    label: "Board meeting",
    priority: "high",
    category: "projects-strategy",
  },
  {
    label: "Finalize Wireco trip and positioning",
    priority: "high",
    category: "projects-strategy",
  },
  {
    label: "Answer DNV about testing rope",
    priority: "medium",
    category: "business-development",
  },
  {
    label: "Select more images to label",
    priority: "medium",
    category: "engineering",
  },
  {
    label: "Check diameters and MRT start",
    priority: "medium",
    category: "engineering",
  },
  {
    label: "Robustification with more cameras",
    priority: "medium",
    category: "engineering",
  },
  {
    label: "Send photo about Carlo",
    priority: "medium",
    category: "personal",
  },
  {
    label: "Check Saipem",
    priority: "medium",
    category: "business-development",
  },
  {
    label: "Check Erwin",
    priority: "medium",
    category: "business-development",
  },
  {
    label: "Answer Bekaert",
    priority: "medium",
    category: "business-development",
  },
  {
    label: "Look at motion magnification algo",
    priority: "low",
    category: "engineering",
  },
  {
    label: "Email Liebherr",
    priority: "low",
    category: "business-development",
  },
  {
    label: "Clean code for analysis of one or multiple images",
    priority: "medium",
    category: "engineering",
  },
  {
    label: "Analyze data Vincent",
    priority: "medium",
    category: "engineering",
  },
  {
    label: "Aga review web",
    priority: "low",
    category: "marketing-web",
  },
];

const priorityRank: Record<TodoPriority, number> = {
  high: 0,
  medium: 1,
  low: 2,
  "needs-triage": 3,
};

const normalizeTaskLabel = (label: string) => label.toLowerCase().replace(/\s+/g, " ").trim();
const toTaskId = (label: string) =>
  normalizeTaskLabel(label)
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

function buildTodoItems(tasks: TodoTaskInput[]): TodoItem[] {
  const uniqueTasks = Array.from(
    new Map(tasks.map((task) => [normalizeTaskLabel(task.label), task])).values(),
  );

  return uniqueTasks
    .map((task) => ({
      ...task,
      id: toTaskId(task.label),
    }))
    .sort((a, b) => {
      const priorityDiff = priorityRank[a.priority] - priorityRank[b.priority];
      if (priorityDiff !== 0) {
        return priorityDiff;
      }
      return a.label.localeCompare(b.label);
    });
}

function buildTodoCategories(items: TodoItem[]): TodoCategory[] {
  const groupedCategories = new Map<TodoCategoryId, TodoItem[]>();
  for (const item of items) {
    const current = groupedCategories.get(item.category) ?? [];
    current.push(item);
    groupedCategories.set(item.category, current);
  }

  return Array.from(groupedCategories.entries())
    .map(([id, categoryItems]) => ({
      id,
      title: categoryMeta[id].title,
      description: categoryMeta[id].description,
      items: categoryItems,
    }))
    .sort((a, b) => {
      const aTopPriority = Math.min(...a.items.map((item) => priorityRank[item.priority]));
      const bTopPriority = Math.min(...b.items.map((item) => priorityRank[item.priority]));
      if (aTopPriority !== bTopPriority) {
        return aTopPriority - bTopPriority;
      }
      return a.title.localeCompare(b.title);
    });
}

const userRequestedItems = buildTodoItems(
  todoSections.userRequested.length > 0 ? todoSections.userRequested : fallbackTasks,
);
const secretaryManagedItems = buildTodoItems(todoSections.secretaryManaged);
const userRequestedCategories = buildTodoCategories(userRequestedItems);
const secretaryManagedCategories = buildTodoCategories(secretaryManagedItems);

const userHighPriorityCount = userRequestedItems.filter((item) => item.priority === "high").length;
const userMediumPriorityCount = userRequestedItems.filter((item) => item.priority === "medium").length;
---
<BaseLayout title="Raidyn Virtual Assistent - Explorer">
  <section class="card home-hero">
    <div class="home-hero__copy">
      <span class="home-hero__eyebrow">Head of Operations</span>
      <h1 class="home-hero__title">Welcome back, Tommaso</h1>
      <p class="home-hero__subtitle">Jump straight into the latest Head of Operations conversation.</p>
    </div>
    <a class="action-button" href="/agents/head-of-operations/conversation">Open latest conversation</a>
  </section>

  {prioritiesHtml && (
    <details class="card foldable-card">
      <summary class="foldable-summary">
        <span class="foldable-title">Raidyn cross-role priorities</span>
        <span class="foldable-meta">5 active priorities</span>
      </summary>
      <div class="foldable-body">
        <p class="meta">Canonical company-level priority stack shared across the active Raidyn roles.</p>
        <div class="markdown-body" set:html={prioritiesHtml} />
        <p class="meta"><a href={companyPageHref}>Open the Raidyn company record</a></p>
      </div>
    </details>
  )}

  <section class="card foldable-card home-todo-card">
    <details data-home-todo open>
      <summary class="foldable-summary">
        <div>
          <div class="foldable-title">Secretary to-do lists</div>
          <p class="foldable-meta">User-requested items stay separate from secretary-managed follow-through.</p>
        </div>
        <div class="todo-summary-badges">
          <span class="priority-pill priority-pill--high" data-user-summary-high>{userHighPriorityCount} user high</span>
          <span class="priority-pill priority-pill--medium" data-user-summary-medium>{userMediumPriorityCount} user medium</span>
          <span class="priority-pill priority-pill--neutral" data-user-summary-overall>{userRequestedItems.length} user total</span>
          <span class="priority-pill priority-pill--neutral">{secretaryManagedItems.length} secretary total</span>
        </div>
      </summary>

      <div class="foldable-body todo-body">
        <div class="todo-category-grid">
          <details class="todo-category-card foldable-card" open>
            <summary class="foldable-summary todo-category-summary">
              <div>
                <h3>User-requested to-do list</h3>
                <p class="meta">These are the items Tommaso explicitly asked to create.</p>
              </div>
              <span class="todo-category-count" data-user-summary-total>{userRequestedItems.length} item{userRequestedItems.length === 1 ? "" : "s"}</span>
            </summary>
            <div class="foldable-body todo-category-body">
              <div class="todo-toolbar">
                <p class="meta">Categories start closed. <strong>Done / delete</strong> removes the item from the real user-requested todo list immediately.</p>
              </div>
              <form class="todo-add-form" data-user-todo-add-form>
                <input
                  type="text"
                  class="todo-add-input"
                  data-user-todo-add-input
                  name="newTodo"
                  maxlength="200"
                  placeholder="Add a user-requested to-do…"
                  aria-label="Add a user-requested to-do"
                  autocomplete="off"
                />
                <button type="submit" class="action-button todo-add-button" data-user-todo-add-button>Add to-do</button>
              </form>
              <div class="todo-category-grid">
                {userRequestedCategories.map((category) => (
                  <details class="todo-category-card foldable-card" data-user-category-id={category.id}>
                    <summary class="foldable-summary todo-category-summary">
                      <div>
                        <h3>{category.title}</h3>
                        <p class="meta">{category.description}</p>
                      </div>
                      <span class="todo-category-count">{category.items.length} item{category.items.length === 1 ? "" : "s"}</span>
                    </summary>
                    <div class="foldable-body todo-category-body">
                      <ul class="todo-item-list">
                        {category.items.map((item) => (
                          <li class="todo-item" data-user-todo-item data-todo-id={item.id} data-todo-priority={item.priority}>
                            <div class="todo-item__content">
                              <span class={`priority-pill priority-pill--${item.priority}`}>
                                {item.priority === "needs-triage" ? "needs priority" : `${item.priority} priority`}
                              </span>
                              <p class="todo-item__label">{item.label}</p>
                            </div>
                            <button type="button" class="todo-delete-button" data-user-todo-delete={item.id} aria-label={`Remove ${item.label}`}>
                              Done / delete
                            </button>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </details>
                ))}
              </div>
              <p class="todo-empty-state meta" data-user-todo-empty hidden>All user-requested tasks have been removed from the live todo list.</p>
            </div>
          </details>

          <details class="todo-category-card foldable-card" open>
            <summary class="foldable-summary todo-category-summary">
              <div>
                <h3>Secretary-managed to-do list</h3>
                <p class="meta">These are the short follow-through items the Secretary is keeping alive without replacing the user list.</p>
              </div>
              <span class="todo-category-count">{secretaryManagedItems.length} item{secretaryManagedItems.length === 1 ? "" : "s"}</span>
            </summary>
            <div class="foldable-body todo-category-body">
              <div class="todo-category-grid">
                {secretaryManagedCategories.map((category) => (
                  <details class="todo-category-card foldable-card">
                    <summary class="foldable-summary todo-category-summary">
                      <div>
                        <h3>{category.title}</h3>
                        <p class="meta">{category.description}</p>
                      </div>
                      <span class="todo-category-count">{category.items.length} item{category.items.length === 1 ? "" : "s"}</span>
                    </summary>
                    <div class="foldable-body todo-category-body">
                      <ul class="todo-item-list">
                        {category.items.map((item) => (
                          <li class="todo-item" data-todo-id={item.id}>
                            <div class="todo-item__content">
                              <span class={`priority-pill priority-pill--${item.priority}`}>
                                {item.priority === "needs-triage" ? "needs priority" : `${item.priority} priority`}
                              </span>
                              <p class="todo-item__label">{item.label}</p>
                            </div>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          </details>
        </div>
      </div>
    </details>
  </section>

  <script is:inline>
    (() => {
      const itemSelector = "[data-user-todo-item]";
      const categorySelector = "[data-user-category-id]";
      const emptyState = document.querySelector("[data-user-todo-empty]");
      const totalBadge = document.querySelector("[data-user-summary-total]");
      const overallBadge = document.querySelector("[data-user-summary-overall]");
      const highBadge = document.querySelector("[data-user-summary-high]");
      const mediumBadge = document.querySelector("[data-user-summary-medium]");

      const visibleItems = () =>
        Array.from(document.querySelectorAll(itemSelector)).filter((item) => item instanceof HTMLElement && !item.hidden);

      const updateCounts = () => {
        const items = visibleItems();
        const highCount = items.filter((item) => item.dataset.todoPriority === "high").length;
        const mediumCount = items.filter((item) => item.dataset.todoPriority === "medium").length;

        if (totalBadge) {
          totalBadge.textContent = `${items.length} item${items.length === 1 ? "" : "s"}`;
        }
        if (overallBadge) {
          overallBadge.textContent = `${items.length} user total`;
        }
        if (highBadge) {
          highBadge.textContent = `${highCount} user high`;
        }
        if (mediumBadge) {
          mediumBadge.textContent = `${mediumCount} user medium`;
        }
        if (emptyState instanceof HTMLElement) {
          emptyState.hidden = items.length > 0;
        }
      };

      const updateCategoryVisibility = () => {
        document.querySelectorAll(categorySelector).forEach((category) => {
          if (!(category instanceof HTMLElement)) {
            return;
          }
          const visibleChildren = Array.from(category.querySelectorAll(itemSelector)).filter(
            (item) => item instanceof HTMLElement && !item.hidden,
          );
          const count = visibleChildren.length;
          const countBadge = category.querySelector(".todo-category-count");
          if (countBadge) {
            countBadge.textContent = `${count} item${count === 1 ? "" : "s"}`;
          }
          category.hidden = count === 0;
        });
      };

      const removeTaskFromDom = (todoId) => {
        const item = document.querySelector(`${itemSelector}[data-todo-id="${CSS.escape(todoId)}"]`);
        if (!(item instanceof HTMLElement)) {
          return;
        }
        item.remove();
        updateCategoryVisibility();
        updateCounts();
      };

      const setButtonBusy = (button, busy) => {
        if (!(button instanceof HTMLButtonElement)) {
          return;
        }
        button.disabled = busy;
        button.textContent = busy ? "Deleting…" : "Done / delete";
      };

      const deleteTodo = async (button) => {
        if (!(button instanceof HTMLButtonElement)) {
          return;
        }
        const todoId = button.getAttribute("data-user-todo-delete") || "";
        const item = button.closest(itemSelector);
        const label = item?.querySelector(".todo-item__label")?.textContent?.trim() || "";
        if (!todoId || !label) {
          return;
        }

        setButtonBusy(button, true);
        try {
          const response = await fetch("/api/secretary-todos/delete", {
            method: "POST",
            headers: {
              "content-type": "application/json",
            },
            body: JSON.stringify({ todoId, label }),
          });

          if (!response.ok) {
            const payload = await response.json().catch(() => ({}));
            throw new Error(payload?.error || "Delete failed.");
          }

          removeTaskFromDom(todoId);
        } catch (error) {
          window.alert(error instanceof Error ? error.message : "Delete failed.");
          setButtonBusy(button, false);
        }
      };

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }

        const deleteButton = target.closest("[data-user-todo-delete]");
        if (deleteButton) {
          event.preventDefault();
          event.stopPropagation();
          void deleteTodo(deleteButton);
        }
      });

      const addForm = document.querySelector("[data-user-todo-add-form]");
      const addInput = document.querySelector("[data-user-todo-add-input]");
      const addButton = document.querySelector("[data-user-todo-add-button]");

      const addTodo = async () => {
        if (!(addInput instanceof HTMLInputElement)) {
          return;
        }
        const label = addInput.value.trim();
        if (!label) {
          return;
        }

        if (addButton instanceof HTMLButtonElement) {
          addButton.disabled = true;
          addButton.textContent = "Adding…";
        }

        try {
          const response = await fetch("/api/secretary-todos/add", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ label }),
          });

          if (!response.ok) {
            const payload = await response.json().catch(() => ({}));
            throw new Error(payload?.error || "Add failed.");
          }

          // Reload so the new item is rendered into the correct category.
          window.location.reload();
        } catch (error) {
          window.alert(error instanceof Error ? error.message : "Add failed.");
          if (addButton instanceof HTMLButtonElement) {
            addButton.disabled = false;
            addButton.textContent = "Add to-do";
          }
        }
      };

      if (addForm instanceof HTMLFormElement) {
        addForm.addEventListener("submit", (event) => {
          event.preventDefault();
          event.stopPropagation();
          void addTodo();
        });
      }

      updateCategoryVisibility();
      updateCounts();
    })();
  </script>
</BaseLayout>
