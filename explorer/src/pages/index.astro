---
import fs from "node:fs/promises";
import BaseLayout from "../layouts/BaseLayout.astro";
import { renderMarkdown } from "../lib/renderers.js";

type TodoPriority = "high" | "medium" | "low" | "needs-triage";

type TodoCategoryId =
  | "business-development"
  | "engineering"
  | "projects-strategy"
  | "marketing-web"
  | "personal";

interface TodoTaskInput {
  label: string;
  priority: TodoPriority;
  category: TodoCategoryId;
}

interface TodoItem extends TodoTaskInput {
  id: string;
}

interface TodoCategory {
  id: TodoCategoryId;
  title: string;
  description: string;
  items: TodoItem[];
}

const categoryMeta: Record<TodoCategoryId, { title: string; description: string }> = {
  "business-development": {
    title: "Business Development",
    description: "Customer follow-up, quotations, and external communication.",
  },
  engineering: {
    title: "Engineering",
    description: "Technical work, analysis, and implementation tasks.",
  },
  "projects-strategy": {
    title: "Projects & Strategy",
    description: "Planning, positioning, coordination, and internal operational work.",
  },
  "marketing-web": {
    title: "Marketing & Web",
    description: "Website, reviews, posts, and public-facing updates.",
  },
  personal: {
    title: "Personal",
    description: "Personal follow-up items.",
  },
};

const secretaryRecordPath = "/home/rva/repos/hermit/workspace/agents/secretary/agent/record.md";
const companyRecordPath = "/home/rva/repos/hermit/workspace/entities/companies/co-raidyn/record.md";
const companyPageHref = "/entities/company/co-raidyn";

function inferCategory(label: string): TodoCategoryId {
  const normalized = label.toLowerCase();

  if (/(raise-of-capital|raise of capital|capital increase)/.test(normalized)) {
    return "projects-strategy";
  }

  if (/(erika)/.test(normalized)) {
    return "personal";
  }

  if (/(post|carosello|website|review)/.test(normalized)) {
    return "marketing-web";
  }

  if (/(car|motorbike|printer|filippo)/.test(normalized)) {
    return "personal";
  }

  if (/(email|answer|call|follow up|jordi|bart|elisabeth|arcelor|bekaert|saipem|deme|dnv|liebherr)/.test(normalized)) {
    return "business-development";
  }

  return "projects-strategy";
}

function cleanTaskLabel(label: string): string {
  return label.trim().replace(/[.]$/, "");
}


function extractMarkdownSection(markdown: string, heading: string): string {
  const escapedHeading = heading.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const match = markdown.match(new RegExp(`## ${escapedHeading}\\n([\\s\\S]*?)(?:\\n## |$)`));
  return match?.[1]?.trim() ?? "";
}

async function loadRaidynCrossRolePrioritiesHtml(): Promise<string> {
  const raw = await fs.readFile(companyRecordPath, "utf8").catch(() => "");
  if (!raw) {
    return "";
  }

  const sectionMarkdown = extractMarkdownSection(raw, "Raidyn Cross-Role Priorities");
  if (!sectionMarkdown) {
    return "";
  }

  return renderMarkdown(sectionMarkdown);
}

async function loadSecretaryTodoTasks(): Promise<TodoTaskInput[]> {
  const raw = await fs.readFile(secretaryRecordPath, "utf8").catch(() => "");
  if (!raw) {
    return [];
  }

  const nextActionsMatch = raw.match(/## Next Actions\s+([\s\S]*?)\n## /);
  const nextActionsBlock = nextActionsMatch?.[1] ?? "";
  const tasks: TodoTaskInput[] = [];

  for (const line of nextActionsBlock.split("\n")) {
    const bullet = line.trim();
    if (!bullet.startsWith("- ")) {
      continue;
    }

    const content = bullet.slice(2).trim();

    let priority: TodoPriority | null = null;
    let label = "";

    const highMatch = content.match(/^High priority:\s*(.+)$/i);
    const mediumMatch = content.match(/^Medium priority:\s*(.+)$/i);
    const lowMatch = content.match(/^Low priority:\s*(.+)$/i);
    const triageMatch = content.match(/^Priority not yet set:\s*(.+)$/i);

    if (highMatch) {
      priority = "high";
      label = cleanTaskLabel(highMatch[1]);
    } else if (mediumMatch) {
      priority = "medium";
      label = cleanTaskLabel(mediumMatch[1]);
    } else if (lowMatch) {
      priority = "low";
      label = cleanTaskLabel(lowMatch[1]);
    } else if (triageMatch) {
      priority = "needs-triage";
      label = cleanTaskLabel(triageMatch[1]);
    }

    if (!priority || !label) {
      continue;
    }

    tasks.push({
      label,
      priority,
      category: inferCategory(label),
    });
  }

  return tasks;
}

const prioritiesHtml = await loadRaidynCrossRolePrioritiesHtml();
const dynamicTasks = await loadSecretaryTodoTasks();

const rawTasks: TodoTaskInput[] = [
  {
    label: "Allow to debug production code",
    priority: "high",
    category: "engineering",
  },
  {
    label: "Write project about Sarens",
    priority: "high",
    category: "projects-strategy",
  },
  {
    label: "Send email to Arcelor",
    priority: "high",
    category: "business-development",
  },
  {
    label: "Implement position estimation",
    priority: "high",
    category: "engineering",
  },
  {
    label: "Make Hermit workspace repo",
    priority: "high",
    category: "projects-strategy",
  },
  {
    label: "Carlo bank transfer",
    priority: "high",
    category: "personal",
  },
  {
    label: "Posts Teufelberger",
    priority: "high",
    category: "marketing-web",
  },
  {
    label: "Post Zermatt",
    priority: "high",
    category: "marketing-web",
  },
  {
    label: "Launch website",
    priority: "high",
    category: "marketing-web",
  },
  {
    label: "Check Deme and send quotation",
    priority: "high",
    category: "business-development",
  },
  {
    label: "Send item to Arcelor",
    priority: "high",
    category: "business-development",
  },
  {
    label: "Board meeting",
    priority: "high",
    category: "projects-strategy",
  },
  {
    label: "Finalize Wireco trip and positioning",
    priority: "high",
    category: "projects-strategy",
  },
  {
    label: "Answer DNV about testing rope",
    priority: "medium",
    category: "business-development",
  },
  {
    label: "Select more images to label",
    priority: "medium",
    category: "engineering",
  },
  {
    label: "Check diameters and MRT start",
    priority: "medium",
    category: "engineering",
  },
  {
    label: "Robustification with more cameras",
    priority: "medium",
    category: "engineering",
  },
  {
    label: "Send photo about Carlo",
    priority: "medium",
    category: "personal",
  },
  {
    label: "Check Saipem",
    priority: "medium",
    category: "business-development",
  },
  {
    label: "Check Erwin",
    priority: "medium",
    category: "business-development",
  },
  {
    label: "Answer Bekaert",
    priority: "medium",
    category: "business-development",
  },
  {
    label: "Look at motion magnification algo",
    priority: "low",
    category: "engineering",
  },
  {
    label: "Email Liebherr",
    priority: "low",
    category: "business-development",
  },
  {
    label: "Clean code for analysis of one or multiple images",
    priority: "medium",
    category: "engineering",
  },
  {
    label: "Analyze data Vincent",
    priority: "medium",
    category: "engineering",
  },
  {
    label: "Aga review web",
    priority: "low",
    category: "marketing-web",
  },
  ...dynamicTasks,
];

const priorityRank: Record<TodoPriority, number> = {
  high: 0,
  medium: 1,
  low: 2,
  "needs-triage": 3,
};

const normalizeTaskLabel = (label: string) => label.toLowerCase().replace(/\s+/g, " ").trim();
const toTaskId = (label: string) =>
  normalizeTaskLabel(label)
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const uniqueTasks = Array.from(
  new Map(rawTasks.map((task) => [normalizeTaskLabel(task.label), task])).values(),
);

const sortedTasks: TodoItem[] = uniqueTasks
  .map((task) => ({
    ...task,
    id: toTaskId(task.label),
  }))
  .sort((a, b) => {
    const priorityDiff = priorityRank[a.priority] - priorityRank[b.priority];
    if (priorityDiff !== 0) {
      return priorityDiff;
    }
    const categoryDiff = categoryMeta[a.category].title.localeCompare(categoryMeta[b.category].title);
    if (categoryDiff !== 0) {
      return categoryDiff;
    }
    return a.label.localeCompare(b.label);
  });

const groupedCategories = new Map<TodoCategoryId, TodoItem[]>();
for (const task of sortedTasks) {
  const current = groupedCategories.get(task.category) ?? [];
  current.push(task);
  groupedCategories.set(task.category, current);
}

const todoCategories: TodoCategory[] = Array.from(groupedCategories.entries())
  .map(([id, items]) => ({
    id,
    title: categoryMeta[id].title,
    description: categoryMeta[id].description,
    items,
  }))
  .sort((a, b) => {
    const aTopPriority = Math.min(...a.items.map((item) => priorityRank[item.priority]));
    const bTopPriority = Math.min(...b.items.map((item) => priorityRank[item.priority]));
    if (aTopPriority !== bTopPriority) {
      return aTopPriority - bTopPriority;
    }
    return a.title.localeCompare(b.title);
  });

const highPriorityCount = sortedTasks.filter((item) => item.priority === "high").length;
const mediumPriorityCount = sortedTasks.filter((item) => item.priority === "medium").length;
const lowPriorityCount = sortedTasks.filter((item) => item.priority === "low").length;
const triageCount = sortedTasks.filter((item) => item.priority === "needs-triage").length;
---
<BaseLayout title="Raidyn Virtual Assistent - Explorer">
  {prioritiesHtml && (
    <section class="card">
      <div class="page-intro" style="margin-bottom: 0.75rem;">
        <h2 style="margin-bottom: 0.25rem;">Raidyn cross-role priorities</h2>
        <p class="meta">Canonical company-level priority stack shared across the active Raidyn roles.</p>
      </div>
      <div class="markdown-body" set:html={prioritiesHtml} />
      <p class="meta"><a href={companyPageHref}>Open the Raidyn company record</a></p>
    </section>
  )}

  <section class="card foldable-card home-todo-card">
    <details data-home-todo>
      <summary class="foldable-summary">
        <div>
          <div class="foldable-title">To-do list</div>
          <p class="foldable-meta">Grouped by category and ordered by priority.</p>
        </div>
        <div class="todo-summary-badges">
          <span class="priority-pill priority-pill--high" data-summary-high>{highPriorityCount} high</span>
          <span class="priority-pill priority-pill--medium" data-summary-medium>{mediumPriorityCount} medium</span>
          <span class="priority-pill priority-pill--low" data-summary-low>{lowPriorityCount} low</span>
          <span class="priority-pill priority-pill--needs-triage" data-summary-triage>{triageCount} needs priority</span>
          <span class="priority-pill priority-pill--neutral" data-summary-total>{sortedTasks.length} total</span>
        </div>
      </summary>

      <div class="foldable-body todo-body">
        <div class="todo-toolbar">
          <p class="meta">Each category can be folded. <strong>Delete</strong> hides a task in this browser. <strong>Reset list</strong> restores hidden items.</p>
          <button type="button" class="todo-reset-button" data-todo-reset>Reset list</button>
        </div>

        <div class="todo-category-grid" data-todo-category-grid>
          {todoCategories.map((category) => (
            <details class="todo-category-card foldable-card" data-category-id={category.id}>
              <summary class="foldable-summary todo-category-summary">
                <div>
                  <h3>{category.title}</h3>
                  <p class="meta">{category.description}</p>
                </div>
                <span class="todo-category-count">{category.items.length} item{category.items.length === 1 ? "" : "s"}</span>
              </summary>

              <div class="foldable-body todo-category-body">
                <ul class="todo-item-list">
                  {category.items.map((item) => (
                    <li class="todo-item" data-todo-item data-todo-id={item.id}>
                      <div class="todo-item__content">
                        <span class={`priority-pill priority-pill--${item.priority}`}>
                          {item.priority === "needs-triage" ? "needs priority" : `${item.priority} priority`}
                        </span>
                        <p class="todo-item__label">{item.label}</p>
                      </div>
                      <button type="button" class="todo-delete-button" data-todo-delete={item.id} aria-label={`Delete ${item.label}`}>
                        Delete
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))}
        </div>

        <p class="todo-empty-state meta" data-todo-empty hidden>All current tasks are hidden in this browser. Use Reset list to show them again.</p>
      </div>
    </details>
  </section>

  <script is:inline>
    (() => {
      const storageKey = "raidyn-home-hidden-todos";
      const itemSelector = "[data-todo-item]";
      const categorySelector = "[data-category-id]";
      const emptyState = document.querySelector("[data-todo-empty]");
      const resetButton = document.querySelector("[data-todo-reset]");
      const highBadge = document.querySelector("[data-summary-high]");
      const mediumBadge = document.querySelector("[data-summary-medium]");
      const lowBadge = document.querySelector("[data-summary-low]");
      const triageBadge = document.querySelector("[data-summary-triage]");
      const totalBadge = document.querySelector("[data-summary-total]");

      const readHiddenIds = () => {
        try {
          const parsed = JSON.parse(localStorage.getItem(storageKey) || "[]");
          return Array.isArray(parsed) ? new Set(parsed.filter((value) => typeof value === "string")) : new Set();
        } catch {
          return new Set();
        }
      };

      const writeHiddenIds = (hiddenIds) => {
        try {
          localStorage.setItem(storageKey, JSON.stringify(Array.from(hiddenIds)));
        } catch {
          // Ignore storage failures and keep the UI responsive.
        }
      };

      const visibleItems = () =>
        Array.from(document.querySelectorAll(itemSelector)).filter((item) => item instanceof HTMLElement && !item.hidden);

      const updateCounts = () => {
        const items = visibleItems();
        const highCount = items.filter((item) => item.querySelector(".priority-pill--high")).length;
        const mediumCount = items.filter((item) => item.querySelector(".priority-pill--medium")).length;
        const lowCount = items.filter((item) => item.querySelector(".priority-pill--low")).length;
        const triageCount = items.filter((item) => item.querySelector(".priority-pill--needs-triage")).length;

        if (highBadge) highBadge.textContent = `${highCount} high`;
        if (mediumBadge) mediumBadge.textContent = `${mediumCount} medium`;
        if (lowBadge) lowBadge.textContent = `${lowCount} low`;
        if (triageBadge) triageBadge.textContent = `${triageCount} needs priority`;
        if (totalBadge) totalBadge.textContent = `${items.length} total`;

        if (emptyState instanceof HTMLElement) {
          emptyState.hidden = items.length > 0;
        }
      };

      const updateCategoryVisibility = () => {
        document.querySelectorAll(categorySelector).forEach((category) => {
          if (!(category instanceof HTMLElement)) {
            return;
          }
          const visibleChildren = Array.from(category.querySelectorAll(itemSelector)).filter(
            (item) => item instanceof HTMLElement && !item.hidden,
          );
          category.hidden = visibleChildren.length === 0;
        });
      };

      const hideTask = (todoId) => {
        if (!todoId) {
          return;
        }
        const hiddenIds = readHiddenIds();
        hiddenIds.add(todoId);
        writeHiddenIds(hiddenIds);
        applyHiddenIds();
      };

      const applyHiddenIds = () => {
        const hiddenIds = readHiddenIds();
        document.querySelectorAll(itemSelector).forEach((item) => {
          if (!(item instanceof HTMLElement)) {
            return;
          }
          const todoId = item.dataset.todoId || "";
          item.hidden = hiddenIds.has(todoId);
          item.style.display = item.hidden ? "none" : "";
        });
        updateCategoryVisibility();
        updateCounts();
      };

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }

        const deleteButton = target.closest("[data-todo-delete]");
        if (deleteButton) {
          event.preventDefault();
          event.stopPropagation();
          hideTask(deleteButton.getAttribute("data-todo-delete"));
          return;
        }

        if (resetButton instanceof HTMLButtonElement && target === resetButton) {
          event.preventDefault();
          writeHiddenIds(new Set());
          applyHiddenIds();
        }
      });

      applyHiddenIds();
    })();
  </script>
</BaseLayout>
