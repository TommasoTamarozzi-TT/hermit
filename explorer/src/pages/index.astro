---
import fs from "node:fs/promises";
import BaseLayout from "../layouts/BaseLayout.astro";
import { renderMarkdown } from "../lib/renderers.js";

type TodoPriority = "high" | "medium" | "low" | "needs-triage";

type TodoCategoryId =
  | "business-development"
  | "engineering"
  | "projects-strategy"
  | "marketing-web"
  | "personal";

interface TodoTaskInput {
  label: string;
  priority: TodoPriority;
  category: TodoCategoryId;
}

interface TodoItem extends TodoTaskInput {
  id: string;
}

interface TodoCategory {
  id: TodoCategoryId;
  title: string;
  description: string;
  items: TodoItem[];
}

const categoryMeta: Record<TodoCategoryId, { title: string; description: string }> = {
  "business-development": {
    title: "Business Development",
    description: "Customer follow-up, quotations, and external communication.",
  },
  engineering: {
    title: "Engineering",
    description: "Technical work, analysis, and implementation tasks.",
  },
  "projects-strategy": {
    title: "Projects & Strategy",
    description: "Planning, positioning, coordination, and internal operational work.",
  },
  "marketing-web": {
    title: "Marketing & Web",
    description: "Website, reviews, posts, and public-facing updates.",
  },
  personal: {
    title: "Personal",
    description: "Personal follow-up items.",
  },
};

const secretaryRecordPath = "/home/rva/repos/hermit/workspace/agents/secretary/agent/record.md";
const companyRecordPath = "/home/rva/repos/hermit/workspace/entities/companies/co-raidyn/record.md";
const companyPageHref = "/entities/company/co-raidyn";

function inferCategory(label: string): TodoCategoryId {
  const normalized = label.toLowerCase();

  if (/(raise-of-capital|raise of capital|capital increase)/.test(normalized)) {
    return "projects-strategy";
  }

  if (/(erika)/.test(normalized)) {
    return "personal";
  }

  if (/(post|carosello|website|review)/.test(normalized)) {
    return "marketing-web";
  }

  if (/(car|motorbike|printer|filippo)/.test(normalized)) {
    return "personal";
  }

  if (/(email|answer|call|follow up|jordi|bart|elisabeth|arcelor|bekaert|saipem|deme|dnv|liebherr)/.test(normalized)) {
    return "business-development";
  }

  return "projects-strategy";
}

function cleanTaskLabel(label: string): string {
  return label.trim().replace(/[.]$/, "");
}


function extractMarkdownSection(markdown: string, heading: string): string {
  const escapedHeading = heading.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const match = markdown.match(new RegExp(`## ${escapedHeading}\\n([\\s\\S]*?)(?:\\n## |$)`));
  return match?.[1]?.trim() ?? "";
}

async function loadRaidynCrossRolePrioritiesHtml(): Promise<string> {
  const raw = await fs.readFile(companyRecordPath, "utf8").catch(() => "");
  if (!raw) {
    return "";
  }

  const sectionMarkdown = extractMarkdownSection(raw, "Raidyn Cross-Role Priorities");
  if (!sectionMarkdown) {
    return "";
  }

  return renderMarkdown(sectionMarkdown);
}

function extractSubheadingSection(markdown: string, heading: string): string {
  const escapedHeading = heading.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const match = markdown.match(new RegExp(`### ${escapedHeading}\\n([\\s\\S]*?)(?:\\n### |$)`));
  return match?.[1]?.trim() ?? "";
}

function parseTodoLines(block: string, defaultPriority: TodoPriority = "medium"): TodoTaskInput[] {
  const tasks: TodoTaskInput[] = [];
  let currentPriority: TodoPriority = defaultPriority;

  for (const line of block.split("\n")) {
    const trimmed = line.trim();
    if (!trimmed) {
      continue;
    }

    if (/^High priority$/i.test(trimmed)) {
      currentPriority = "high";
      continue;
    }
    if (/^Medium priority$/i.test(trimmed)) {
      currentPriority = "medium";
      continue;
    }
    if (/^Low priority$/i.test(trimmed)) {
      currentPriority = "low";
      continue;
    }
    if (/^Priority not yet set$/i.test(trimmed)) {
      currentPriority = "needs-triage";
      continue;
    }
    if (!trimmed.startsWith("- ")) {
      continue;
    }

    const content = trimmed.slice(2).trim();
    const explicitHigh = content.match(/^High priority:\s*(.+)$/i);
    const explicitMedium = content.match(/^Medium priority:\s*(.+)$/i);
    const explicitLow = content.match(/^Low priority:\s*(.+)$/i);
    const explicitTriage = content.match(/^Priority not yet set:\s*(.+)$/i);

    let priority = currentPriority;
    let label = cleanTaskLabel(content);

    if (explicitHigh) {
      priority = "high";
      label = cleanTaskLabel(explicitHigh[1]);
    } else if (explicitMedium) {
      priority = "medium";
      label = cleanTaskLabel(explicitMedium[1]);
    } else if (explicitLow) {
      priority = "low";
      label = cleanTaskLabel(explicitLow[1]);
    } else if (explicitTriage) {
      priority = "needs-triage";
      label = cleanTaskLabel(explicitTriage[1]);
    }

    if (!label) {
      continue;
    }

    tasks.push({
      label,
      priority,
      category: inferCategory(label),
    });
  }

  return tasks;
}

async function loadSecretaryTodoSections(): Promise<{ userRequested: TodoTaskInput[]; secretaryManaged: TodoTaskInput[] }> {
  const raw = await fs.readFile(secretaryRecordPath, "utf8").catch(() => "");
  if (!raw) {
    return { userRequested: [], secretaryManaged: [] };
  }

  const nextActionsMatch = raw.match(/## Next Actions\s+([\s\S]*?)\n## /);
  const nextActionsBlock = nextActionsMatch?.[1] ?? "";
  const userRequestedBlock = extractSubheadingSection(nextActionsBlock, "User-requested todo list");
  const secretaryManagedBlock = extractSubheadingSection(nextActionsBlock, "Secretary-managed todo list");

  return {
    userRequested: parseTodoLines(userRequestedBlock, "medium"),
    secretaryManaged: parseTodoLines(secretaryManagedBlock, "medium"),
  };
}

const prioritiesHtml = await loadRaidynCrossRolePrioritiesHtml();
const todoSections = await loadSecretaryTodoSections();

