---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AgentsSectionTabs from "../../components/AgentsSectionTabs.astro";
import { getWorkspaceRoot, listRoleIds, loadRole } from "../../lib/workspace.js";
import { getVirtualAgentsData, raidynChiefExecutive, teamMembers } from "../../lib/raidyn-org.js";

const root = getWorkspaceRoot();
const roleIds = await listRoleIds(root);
const roles = await Promise.all(
  roleIds.map(async (roleId) => {
    const role = await loadRole(root, roleId);
    return {
      id: roleId,
      name: role.name,
      description: role.description,
    };
  }),
);

const { headOfOperations, reports: virtualReports } = getVirtualAgentsData(roles);
const directTeamMembers = teamMembers.filter((person) => !person.reportsTo);
const pavelReports = teamMembers.filter((person) => person.reportsTo === "pavel");
---
<BaseLayout title="Orgchart">
  <div class="breadcrumb">
    <a href="/">Raidyn Virtual Assistent - Explorer</a> → Orgchart
  </div>
  <div class="page-intro">
    <h1>Orgchart</h1>
    <p class="meta">
      {teamMembers.length} team member{teamMembers.length !== 1 ? "s" : ""} and {roles.length} virtual role
      {roles.length !== 1 ? "s" : ""}
    </p>
  </div>

  <div class="page-with-sidebar">
    <aside class="card section-sidebar">
      <AgentsSectionTabs active="org-chart" />
    </aside>

    <div class="section-content">
      <section class="org-chart">
        <div class="org-chart-root">
          <article class="org-node org-node--executive">
            <span class="org-node__eyebrow">Raidyn leadership</span>
            <h2 class="org-node__name">{raidynChiefExecutive.name}</h2>
            <p class="org-node__title">{raidynChiefExecutive.title}</p>
          </article>
        </div>

        <div class="org-branch-grid">
          <section class="card org-branch">
            <div class="org-branch-heading">
              <span class="org-branch__badge">Team members</span>
              <p class="meta">Core people structure from the latest internal brief.</p>
            </div>

            <div class="org-node-grid">
              {directTeamMembers.map((person) => (
                <div class="org-node-stack">
                  <article class:list={{ "org-node": true, "org-node--lead": person.id === "pavel" }}>
                    <span class="org-node__eyebrow">Team member</span>
                    <h3 class="org-node__name">{person.name}</h3>
                    <p class="org-node__title">{person.title}</p>
                  </article>

                  {person.id === "pavel" && pavelReports.length > 0 && (
                    <div class="org-report-list" aria-label="Pavel direct reports">
                      {pavelReports.map((report) => (
                        <article class="org-node org-node--report">
                          <span class="org-node__eyebrow">Reports to Pavel</span>
                          <h3 class="org-node__name">{report.name}</h3>
                          <p class="org-node__title">{report.title}</p>
                        </article>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>

          <section class="card org-branch">
            <div class="org-branch-heading">
              <span class="org-branch__badge org-branch__badge--virtual">Virtual agents</span>
              <p class="meta">This branch updates automatically from the current role folders in `workspace/agents/`.</p>
            </div>

            <div class="org-node-stack">
              <article class="org-node org-node--lead">
                <span class="org-node__eyebrow">Virtual operations lead</span>
                <h3 class="org-node__name">{headOfOperations.name}</h3>
                <p class="org-node__title">Coordinates the virtual-agent org</p>
                <p class="org-node__description">{headOfOperations.description}</p>
                <div class="org-node__actions">
                  <a class="action-button" href={headOfOperations.href}>Agent definition</a>
                  <a class="action-button action-button--secondary" href={headOfOperations.conversationHref}>Last conversation</a>
                  <a class="action-button action-button--secondary" href={headOfOperations.oneOnOneHref}>1 on 1</a>
                </div>
              </article>

              {virtualReports.length > 0 ? (
                <div class="org-report-list org-report-list--agents" aria-label="Head of Operations direct reports">
                  {virtualReports.map((role) => (
                    <article class="org-node org-node--agent">
                      <span class="org-node__eyebrow">Reports to Head of Operations</span>
                      <h3 class="org-node__name">{role.name}</h3>
                      <p class="org-node__description">{role.description}</p>
                      <div class="org-node__actions">
                        <a class="action-button" href={role.href}>Agent definition</a>
                        <a class="action-button action-button--secondary" href={role.conversationHref}>Last conversation</a>
                        <a class="action-button action-button--secondary" href={role.oneOnOneHref}>1 on 1</a>
                      </div>
                    </article>
                  ))}
                </div>
              ) : (
                <p class="meta">No direct-report agents are registered yet.</p>
              )}
            </div>
          </section>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
