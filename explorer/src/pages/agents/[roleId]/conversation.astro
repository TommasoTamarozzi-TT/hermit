---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { loadLatestRoleConversation } from "../../../lib/session-history.ts";
import { getWorkspaceRoot, loadRole } from "../../../lib/workspace.js";

const { roleId } = Astro.params;
if (!roleId) return Astro.redirect("/");

const root = getWorkspaceRoot();
const role = await loadRole(root, roleId);
const conversation = await loadLatestRoleConversation(role);
const chatEntries = conversation.entries.filter((entry) => {
  if (entry.kind === "user") {
    return Boolean(entry.text && entry.text.trim().length > 0);
  }
  if (entry.kind === "assistant") {
    return Boolean(entry.text && entry.text.trim().length > 0);
  }
  return false;
});
---
<BaseLayout title={`${role.name} chat`} roleId={role.id} roleName={role.name}>
  <div class="breadcrumb">
    <a href="/">Raidyn Virtual Assistent - Explorer</a> →
    <a href="/agents">Orgchart</a> →
    <a href="/agents/conversations">Conversations</a> →
    {role.name}
  </div>

  <div class="page-intro">
    <h1>{role.name} · last chat</h1>
    <p class="meta">{role.description}</p>
  </div>

  <div class="page-actions">
    <a class="action-button" href={`/agents/${role.id}`}>Agent definition</a>
    <a class="action-button action-button--secondary" href={`/agents/${role.id}/one-on-one`}>1 on 1</a>
    <a class="action-button action-button--secondary" href="/agents/conversations">All conversations</a>
  </div>

  {conversation.sessionPath ? (
    <>
      <section class="card conversation-summary-card">
        <dl class="conversation-meta-list conversation-meta-list--compact">
          <div>
            <dt>Updated</dt>
            <dd>{conversation.lastUpdatedAt ?? "Unknown"}</dd>
          </div>
          <div>
            <dt>Model</dt>
            <dd>{conversation.currentModel ?? "Unknown"}</dd>
          </div>
          <div>
            <dt>Messages</dt>
            <dd>{chatEntries.length}</dd>
          </div>
        </dl>
      </section>

      <section class="chat-thread">
        {chatEntries.map((entry) => (
          <article class:list={{
            "card": true,
            "chat-message": true,
            "chat-message--user": entry.kind === "user",
            "chat-message--assistant": entry.kind === "assistant",
          }}>
            <div class="chat-message__header">
              <div class="chat-message__identity">
                <span class="chat-message__speaker">{entry.kind === "user" ? "You" : role.name}</span>
                {entry.kind === "assistant" && (entry.assistantModel || conversation.currentModel) && (
                  <span class="chat-message__model">{entry.assistantModel || conversation.currentModel}</span>
                )}
              </div>
              {entry.timestamp && <time class="chat-message__time">{entry.timestamp}</time>}
            </div>

            <pre class="plain-pre plain-pre--chat">{entry.text}</pre>
          </article>
        ))}
      </section>
    </>
  ) : (
    <section class="card empty-state-card">
      <h2>No saved chat yet</h2>
      <p class="meta">This agent does not have a stored chat yet.</p>
    </section>
  )}
</BaseLayout>
