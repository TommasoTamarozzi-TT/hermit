---
import path from "node:path";
import { promises as fs } from "node:fs";
import BaseLayout from "../layouts/BaseLayout.astro";
import { countEntitiesByDefinition, getFrameworkRoot, getWorkspaceRoot, loadEntityDefs } from "../lib/workspace.js";
import { marked } from "marked";

const root = getWorkspaceRoot();
const frameworkRoot = getFrameworkRoot();
const { entities: entityDefs } = await loadEntityDefs(root);

marked.setOptions({ gfm: true });

async function readTextFile(filePath: string): Promise<string> {
  return fs.readFile(filePath, "utf8").catch((error) => {
    const code = error && typeof error === "object" && "code" in error ? (error as NodeJS.ErrnoException).code : undefined;
    if (code === "ENOENT") {
      return "";
    }
    throw error;
  });
}

const [readmeRaw, architectureRaw, licenseContent, entityTypes] = await Promise.all([
  readTextFile(path.join(frameworkRoot, "README.md")),
  readTextFile(path.join(frameworkRoot, "docs", "architecture.md")),
  readTextFile(path.join(frameworkRoot, "LICENSE")),
  Promise.all(
    entityDefs.map(async (entityDef) => ({
      entityDef,
      count: await countEntitiesByDefinition(root, entityDef),
    })),
  ),
]);

const readmeHtml = readmeRaw
  ? (await marked.parse(readmeRaw))
      .replace('src="public/mascot.png"', 'src="/mascot.png"')
      .replace(/href="docs\/architecture\.md"/g, 'href="/architecture"')
      .replace(/href="LICENSE"/g, 'href="/license"')
  : "";
const architectureHtml = architectureRaw ? await marked.parse(architectureRaw) : "";
---
<BaseLayout title="Hermit info">
  <div class="breadcrumb">
    <a href="/">Raidyn Virtual Assistent - Explorer</a> → Hermit info
  </div>
  <div class="page-intro">
    <h1>Hermit info</h1>
    <p class="meta">Hermit overview, workspace entities, runtime architecture, and license details.</p>
  </div>

  <section class="file-section card">
    <div class="section-header">
      <div>
        <h2>Entities</h2>
        <p class="meta">Browse the workspace entity catalog by type.</p>
      </div>
      <a class="action-button action-button--secondary" href="/entities">Open entity catalog</a>
    </div>

    <div class="entity-type-list">
      {entityTypes.map(({ entityDef, count }) => (
        <a href={`/entities/${entityDef.type}`}>
          <strong>{entityDef.label}</strong>
          <span class="meta"> — {count} record{count !== 1 ? "s" : ""}</span>
        </a>
      ))}
    </div>
  </section>

  {readmeHtml && (
    <details class="file-section card foldable-card" open>
      <summary class="foldable-summary">
        <span class="foldable-title">README</span>
        <span class="foldable-meta">Hermit overview, setup notes, and documentation links</span>
      </summary>
      <div class="foldable-body">
        <div class="markdown-body" set:html={readmeHtml} />
      </div>
    </details>
  )}

  <details class="file-section card foldable-card">
    <summary class="foldable-summary">
      <span class="foldable-title">Architecture</span>
      <span class="foldable-meta">Design document for the Hermit runtime</span>
    </summary>
    <div class="foldable-body">
      <div class="section-actions">
        <a class="action-button action-button--secondary" href="/architecture">Open standalone architecture page</a>
      </div>
      {architectureHtml ? <div class="markdown-body" set:html={architectureHtml} /> : <p>File not found.</p>}
    </div>
  </details>

  <details class="file-section card foldable-card">
    <summary class="foldable-summary">
      <span class="foldable-title">License</span>
      <span class="foldable-meta">Current Hermit license text</span>
    </summary>
    <div class="foldable-body">
      <div class="section-actions">
        <a class="action-button action-button--secondary" href="/license">Open standalone license page</a>
      </div>
      {licenseContent ? <pre class="plain-pre">{licenseContent}</pre> : <p>File not found.</p>}
    </div>
  </details>
</BaseLayout>

<style>
  .section-header,
  .section-actions {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-actions {
    margin-bottom: 1rem;
  }

  @media (max-width: 720px) {
    .section-header,
    .section-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
