---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Tables">
  <div class="breadcrumb">
    <a href="/">Raidyn Virtual Assistent - Explorer</a> → Tables
  </div>
  <div class="page-intro">
    <h1 class="page-title">Tables</h1>
    <p class="meta">Quick links to summary tables and operational views.</p>
  </div>

  <div class="entity-type-list">
    <a href="/daily-digest">
      <strong class="link-title">Daily Digest</strong>
      <span class="meta"> — today&apos;s emails, calendar action days, and the latest digest view</span>
    </a>
    <a href="/slack-summary">
      <strong class="link-title">Slack Summary</strong>
      <span class="meta"> — unread DMs plus channel activity since the last scan</span>
    </a>
  </div>
</BaseLayout>

<style>
  .link-title {
    display: block;
  }
</style>
