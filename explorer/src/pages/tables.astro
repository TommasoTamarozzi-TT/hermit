---
import path from "node:path";
import { promises as fs } from "node:fs";

import BaseLayout from "../layouts/BaseLayout.astro";
import { renderMarkdown } from "../lib/renderers.js";
import { getWorkspaceRoot } from "../lib/workspace.js";

const root = getWorkspaceRoot();
const digestWorkItemPath = path.join(root, "entities", "work-items", "wi-set-up-daily-email-and-calendar-digest");
const slackWorkItemPath = path.join(root, "entities", "work-items", "wi-set-up-slack-unread-summary-table");

async function readMarkdownFile(filePath: string): Promise<string | undefined> {
  try {
    return await fs.readFile(filePath, "utf8");
  } catch (error) {
    const code = error && typeof error === "object" && "code" in error ? (error as NodeJS.ErrnoException).code : undefined;
    if (code === "ENOENT") {
      return undefined;
    }
    throw error;
  }
}

const [unreadMarkdown, calendarMarkdown, slackMarkdown, digestMarkdown] = await Promise.all([
  readMarkdownFile(path.join(digestWorkItemPath, "unread-email-explorer.md")),
  readMarkdownFile(path.join(digestWorkItemPath, "calendar-action-days.md")),
  readMarkdownFile(path.join(slackWorkItemPath, "latest-slack-summary.md")),
  readMarkdownFile(path.join(digestWorkItemPath, "latest-email-digest.md")),
]);

const [unreadHtml, calendarHtml, slackHtml, digestHtml] = await Promise.all([
  unreadMarkdown ? renderMarkdown(unreadMarkdown) : undefined,
  calendarMarkdown ? renderMarkdown(calendarMarkdown) : undefined,
  slackMarkdown ? renderMarkdown(slackMarkdown) : undefined,
  digestMarkdown ? renderMarkdown(digestMarkdown) : undefined,
]);
---
<BaseLayout title="Tables">
  <div class="breadcrumb">
    <a href="/">Raidyn Virtual Assistent - Explorer</a> → Tables
  </div>
  <div class="page-intro">
    <h1 class="page-title">Tables</h1>
    <p class="meta">Live operational summaries for unread email, forward-looking calendar days, Slack activity, and the latest digest snapshot.</p>
  </div>

  <details class="file-section card foldable-card" open>
    <summary class="foldable-summary">
      <span class="foldable-title">Unread email view</span>
      <span class="foldable-meta">Open the latest unread email snapshot</span>
    </summary>
    <div class="foldable-body foldable-body--flush">
      {unreadHtml ? (
        <div class="markdown-body" set:html={unreadHtml} />
      ) : (
        <div class="markdown-body"><p>No unread email snapshot has been generated yet.</p></div>
      )}
    </div>
  </details>

  <details class="file-section card foldable-card">
    <summary class="foldable-summary">
      <span class="foldable-title">Calendar action days</span>
      <span class="foldable-meta">Open the forward-looking calendar action view</span>
    </summary>
    <div class="foldable-body foldable-body--flush">
      {calendarHtml ? (
        <div class="markdown-body" set:html={calendarHtml} />
      ) : (
        <div class="markdown-body"><p>No calendar action snapshot has been generated yet.</p></div>
      )}
    </div>
  </details>

  <details class="file-section card foldable-card">
    <summary class="foldable-summary">
      <span class="foldable-title">Slack summary</span>
      <span class="foldable-meta">Open the latest Slack activity snapshot</span>
    </summary>
    <div class="foldable-body foldable-body--flush">
      {slackHtml ? (
        <div class="markdown-body" set:html={slackHtml} />
      ) : (
        <div class="markdown-body"><p>No Slack summary has been generated yet.</p></div>
      )}
    </div>
  </details>

  <details class="file-section card foldable-card">
    <summary class="foldable-summary">
      <span class="foldable-title">Latest digest email</span>
      <span class="foldable-meta">Open the full generated digest snapshot</span>
    </summary>
    <div class="foldable-body foldable-body--flush">
      {digestHtml ? (
        <div class="markdown-body" set:html={digestHtml} />
      ) : (
        <div class="markdown-body"><p>No digest snapshot has been generated yet.</p></div>
      )}
    </div>
  </details>
</BaseLayout>

